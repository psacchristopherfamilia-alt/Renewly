# Supabase project (Settings → API). The anon/publishable key is safe in the browser: RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the app, used in email links (confirmations, invitations).
APP_URL=https://app.renewly.example
# Sales page URL, for the terms and privacy links on sign-up.
NEXT_PUBLIC_LANDING_URL=https://renewly.example
# Invitation emails (optional: without them the team page shows the link to share by hand).
RESEND_API_KEY=
EMAIL_FROM="Renewly <hello@your-verified-domain>"
# Daily reminders job (/api/cron/reminders, 12:00 UTC = 8:00 TCI). Vercel Cron sends this secret automatically.
CRON_SECRET=
# Server only: lets the reminders job read every organisation's due dates. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Shown on the help page.
NEXT_PUBLIC_SUPPORT_EMAIL=
