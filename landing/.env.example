# Public URL of the sales page (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://renewly.example
# WhatsApp number in international format, digits only (empty hides the button)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Legal entity and contact email shown in the privacy policy and terms
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_CONTACT_EMAIL=

# Server only. Never expose these to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LEADS_IP_SALT=change-me-to-a-long-random-string
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=
LEADS_FROM_EMAIL="Renewly <hello@your-verified-domain>"
